# === PostgreSQL ===
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=hotel_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_PORT=5432

# === Puertos ===
BACKEND_PORT=8000
FRONTEND_PORT=80

# === pgAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@hotel.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# === Django ===
DJANGO_SECRET_KEY=dev-insecure-cambiar-en-produccion
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,*
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173